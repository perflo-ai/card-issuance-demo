# Copy to .env and fill in. Never commit .env, and never put a real secret in this file.
# On a host there is no .env: set the same names as the host's variables.

# mock: the built-in test payments service (no Perflo backend needed, this computer only).
# live: a real Perflo backend at PERFLO_API_BASE. Live mode moves real money: use test accounts.
DEMO_MODE=mock

# Mock mode: the test payments service listens here (must be localhost, not port 5174).
# Live mode: the Perflo backend, for example http://localhost:3001 for a local perflo-backend-api
# with PARTNER_V2_ENABLED=true, or a staging host that serves /partner/v2. Never production.
PERFLO_API_BASE=https://localhost:8791

# Partner credentials. Live mode: from POST /v1/agents/:agent_id/partner-credentials (the secret is
# shown once; keep it in a secret store). Mock mode: any values in the right shape:
#   PARTNER_ID:      node -e "console.log(require('crypto').randomUUID())"
#   PARTNER_SECRET:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PARTNER_ID=
PARTNER_KEY_VERSION=v1
PARTNER_SECRET=

# Webhooks. Tiny does not poll: Perflo tells it when an order or a person changes. Live mode (required): in
# Perflo Builder save the webhook address https://<where Tiny runs>/webhooks/perflo, then paste the webhook
# secret it shows (whsec_..., not PARTNER_SECRET). After rotating it in Builder, paste the new one and restart.
# Mock mode: leave unset; the mock signs with a fresh secret each run.
PERFLO_WEBHOOK_SECRET=

# Optional: where users, orders and access tokens are kept (owner-only file). On a host, point it at a
# mounted volume, or everyone must connect again after each deploy.
# DEMO_DATA_FILE=data/demo-store.json

# Hosted only (the host sets PORT). Leave both unset on this computer (https://localhost:5174).
# PORT=8080
# The address people open the demo at. Every change request must come from it; without it the
# request's Origin must match the Host header the host forwards.
# DEMO_PUBLIC_ORIGIN=https://tiny-demo.up.railway.app
