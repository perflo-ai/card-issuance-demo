# Copy to .env and fill in. Never commit .env.

# mock: run against the built-in test payments service (no Perflo backends needed).
# live: talk to a real Perflo backend at PERFLO_API_BASE.
DEMO_MODE=mock

# Mock mode: the test payments service listens on this URL (must be localhost, not port 5174).
# Live mode: the Perflo backend, for example http://localhost:3001 for a local perflo-backend-api
# with PARTNER_V2_ENABLED=true. Never point a demo at production.
PERFLO_API_BASE=https://localhost:8791

# Partner credentials. In live mode these come from POST /v1/agents/:agent_id/partner-credentials
# (the secret is shown once). In mock mode any values in the right shape work:
#   PARTNER_ID:      node -e "console.log(require('crypto').randomUUID())"
#   PARTNER_SECRET:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PARTNER_ID=
PARTNER_KEY_VERSION=v1
PARTNER_SECRET=

# Optional: where the demo keeps its users, orders and access tokens (owner-only file).
# DEMO_DATA_FILE=data/demo-store.json
