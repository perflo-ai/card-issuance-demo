{
  "name": "perflo-partner-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Demo partner app (Tiny) integrating the Perflo Partner API v2. Local only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cert": "sh scripts/make-cert.sh",
    "dev": "NODE_EXTRA_CA_CERTS=certs/localhost.pem tsx watch --env-file=.env server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production NODE_EXTRA_CA_CERTS=certs/localhost.pem node --env-file=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
